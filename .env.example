# Use the Calibre server over the network:
CALIBRE_URL=http://localhost:8090
# Set these if the Calibre server requires authentication:
# CALIBRE_USERNAME=your-username
# CALIBRE_PASSWORD=your-password

# Alternatively, read Calibre's SQLite database directly:
# CALIBRE_DB_PATH=/path/to/metadata.db

# Optional PostgreSQL connection:
# DATABASE_URL=postgresql://user:password@localhost:5432/calibre
